

//=========================================================
// Latin
//=========================================================


phoneme a
  vwl starttype #a endtype #a
  length 170
  ipa a
  FMT(vowel/a_5)
endphoneme


phoneme E
  vwl starttype #e endtype #e
  length 170
  ipa ɛ
  IF nextPhW(isVowel) THEN
    ipa e
  ENDIF
  FMT(vowel/ee_1)
endphoneme


phoneme I
  vwl starttype #i endtype #i
  length 150
  IfNextVowelAppend(;)
  ipa ɪ
  // if it is a vowel, there will be a ; in between
  IF next2PhW(isVowel) THEN
    ipa i
  ENDIF
  FMT(vowel/ii_5)
endphoneme


phoneme O
  vwl starttype #o endtype #o
  length 160
  ipa ɔ
  IF nextPhW(isVowel) THEN
    ipa o
  ENDIF
  FMT(vowel/o)
endphoneme


phoneme U
  vwl starttype #u endtype #u
  length 160
  ipa ʊ
  IF nextPhW(isVowel) THEN
    ipa u
  ENDIF
  FMT(vowel/u)
endphoneme


phoneme a:
  vwl starttype #a endtype #a
  length 270
  ipa aː
  FMT(vowel/a_3)
endphoneme


phoneme e:
  vwl starttype #e endtype #e
  length 260
  ipa eː
  FMT(vowel/e)
endphoneme


phoneme i:
  vwl starttype #i endtype #i
  length 240
  ipa iː
  FMT(vowel/i_2)
endphoneme


phoneme o:
  vwl starttype #o endtype #o
  length 250
  ipa oː
  FMT(vowel/o_2)
endphoneme


phoneme u:
  vwl starttype #u endtype #u
  length 250
  ipa uː
  FMT(vowel/u_bck2)
endphoneme


phoneme y
  vwl starttype #i endtype #i
  length 150
  ipa ʏ
  FMT(vowel/y)
endphoneme

phoneme y:
  vwl starttype #i endtype #i
  length 250
  FMT(vowel/y_2)
endphoneme


// Diphthongs


phoneme aE
  vwl starttype #a endtype #i
  length 270
  ipa ae̯
  FMT(vdiph/ae)
endphoneme


phoneme aU
  vwl starttype #a endtype #u
  length 270
  ipa au̯
  FMT(vdiph/aau_2)
endphoneme


phoneme eI
  vwl starttype #e endtype #i
  length 270
  ipa ei̯
  FMT(vdiph/ei)
endphoneme


phoneme OE
  vwl starttype #o endtype #e
  length 250
  ipa oe̯
  FMT(vowel/oe)
endphoneme


// Rare Diphthongs

// Per Allen 2003, p. 63
// confined to the forms neu, ceu, seu, the interjections heu and heus, and
// Greek proper names and borrowings such as Orpheus, Europa, euge, eunuchus.
phoneme E_U
  vwl starttype #e endtype #u
  length 270
  ipa ɛu̯
  FMT(vdiph/eeu_2)
endphoneme


// Per Allen 2003, p. 63
// found only in the contracted form prout
// combination of short o and u
phoneme O_U
  vwl starttype #o endtype #u
  length 250
  ipa ou̯
  FMT(vdiph/ou)
endphoneme

// Per Allen 2003 p. 62-63
// short u with an i
// only in huius, cuius, huic, cui, hui
phoneme U_I
  vwl starttype #u endtype #i
  length 250
  ipa ui̯
  FMT(vdiph/ui)
endphoneme

//===========
// CONSONANTS
//===========


phoneme p // unaspirated
  import_phoneme consonants/p-
  voicingswitch b
endphoneme


// <h> should actually be a modifier of a phoneme, but we use a short /h/ here.
phoneme <h>
  vls glt apr
  length 50
  lengthmod 3
  ipa ʰ

  IF nextPh(#@) THEN
    WAV(h/h@)
  ELIF nextPh(#a) THEN
    WAV(h/ha)
  ELIF nextPh(#e) THEN
    WAV(h/he)
  ELIF nextPh(#i) THEN
    WAV(h/hi)
  ELIF nextPh(#o) THEN
    WAV(h/ho)
  ELIF nextPh(#u) THEN
    WAV(h/hu)
  ENDIF
  WAV(h/h_, 70)  // no vowel following
endphoneme


// Allen, Vox Latina, Chapter 1, Section v
// Use 'dark' l (l/2) at the end of a word or another consonant

phoneme l
  ipa l
  import_phoneme base1/l
endphoneme

phoneme l/2
  ipa ɫ
  import_phoneme base1/l/2
endphoneme
