endphoneme

phoneme e:
  ipa e:
  vwl starttype #e endtype #e
  length 330
  FMT(mongolian/e_long)
endphoneme

phoneme i:
  ipa i:
  vwl starttype #i endtype #i
  length 310
  FMT(mongolian/i_long)
endphoneme

phoneme O:
  ipa O:
  vwl starttype #o endtype #o
  length 330
  FMT(mongolian/O_long)
endphoneme

phoneme 8:
  ipa 8:
  vwl starttype #o endtype #o
  length 330
  FMT(mongolian/oe_long)
endphoneme

phoneme U:
  ipa U:
  vwl starttype #u endtype #u
  length 330
  FMT(mongolian/u_long)
