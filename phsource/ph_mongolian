// ============================================================
//  Khalkha Mongolian phoneme inventory
//
//  Vowels: 7 short, 7 long, 6 diphthongs, 1 epenthetic schwa.
//  Vowel harmony is pharyngeal: RTR {a, O, U} vs ATR {e, 8, y};
//  i is neutral. The contrast is carried by F1, not by backness.
//
//  Consonants: Khalkha contrasts ASPIRATION, not voicing.
//    б /p/   п /pʰ/    д /t/   т /tʰ/    г /k~ɢ/  к /kʰ/
//    з /ts/  ц /tsʰ/   ж /tʃ/  ч /tʃʰ/
//  The voiced series (b d g dZ z v) is retained for loanwords
//  only -- native Khalkha words never use it.
//
//  Reference: Svantesson, Tsendina, Karlsson & Franzen,
//  "The Phonology of Mongolian", OUP 2005.
//
//  ON THE VOWEL DATA IN phsource/mongolian/
//
//  These files are NOT independently extracted recordings, despite what
//  earlier comments here claimed. All 19 of them share the same three
//  peak-amplitude signatures byte for byte -- an onset ramp, a steady
//  state and an offset ramp -- and differ only in peak FREQUENCIES.
//  That is a formant template with per-vowel values filled in, which no
//  set of real per-vowel Praat extractions could produce.
//
//  F1 and F2 are now MEASURED from real Mongolian speech: word-initial
//  (hence stressed and unreduced) vowels in the mbspeech corpus, 3,270
//  utterances, thousands of tokens per vowel. The ATR/RTR pattern below
//  was independently replicated on multi-speaker fleurs-mn.
//
//  Khalkha harmony is PHARYNGEAL (ATR/RTR), not front/back. The ATR
//  member of each pair is marked by LOWER F1; F2 rises only for the
//  unrounded pair and actually FALLS slightly for the rounded ones.
//  Measured, mbspeech / fleurs-mn:
//
//      а -> э   F1 -171 / -258      F2  +526 / +433
//      о -> ө   F1  -98 / -166      F2    -7 /  -75
//      у -> ү   F1  -19 /  -85      F2  -190 /  -73
//
//  An earlier revision of this file assumed harmony was front/back and
//  raised F2 for ө and ү to "separate" them from о and у. That was the
//  wrong model: the corpus shows ө sits at or just below о in F2, and ү
//  well below у. Those values have been replaced by the measured ones.
//
//  F3 is NOT measured. Adopting measured F3 scored significantly worse
//  against human speech than leaving it alone (F2 distance 480.9 -> 455.1
//  when F3 was left at its previous values, CI [-33.2, -18.3], better on
//  67 of 80 utterances), so only F1 and F2 come from the corpus.
// ============================================================


// ============================================================
//  VOWELS
// ============================================================

// -- SHORT VOWELS -------------------------------------------------

// a /a/ - open central-to-back unrounded
phoneme a
  ipa a
  vwl starttype #a endtype #a
  length 150
  ChangeIfUnstressed(a#)
  FMT(mongolian/a)
endphoneme

// Reduced a in unstressed positions (same quality, just shorter)
phoneme a#
  // Reduction lowers F1 only -- F2, F3 and every amplitude are byte-identical
  // to the full vowel, and the pairs move together. See mn.md section 10h.
  ipa a
  vwl starttype #a endtype #a
  length 100
  FMT(mongolian/a_red)
endphoneme

// e /e/ - front mid unrounded
phoneme e
  ipa e
  vwl starttype #e endtype #e
  length 150
  ChangeIfUnstressed(e#)
  FMT(mongolian/e)
endphoneme

// Reduced e (same quality, just shorter)
phoneme e#
  // Reduction lowers F1 only -- F2, F3 and every amplitude are byte-identical
  // to the full vowel, and the pairs move together. See mn.md section 10h.
  ipa e
  vwl starttype #e endtype #e
  length 100
  FMT(mongolian/e_red)
endphoneme

// i /i/ - front close unrounded (vowel-harmony neutral)
phoneme i
  ipa i
  vwl starttype #i endtype #i
  length 140
  ChangeIfUnstressed(i#)
  FMT(mongolian/i)
endphoneme

// Reduced i -- centralized, not merely shorter. The speaker moves и from
// F2 2062 to 1871 when unstressed; keeping the full-vowel target here made
// every unstressed syllable fully articulated, which reads as robotic.
phoneme i#
  ipa i
  vwl starttype #i endtype #i
  length 95
  FMT(mongolian/i)
endphoneme

// O /ɔ/ - back mid rounded, RTR. Measured F1 424, F2 1089.
phoneme O
  ipa O
  vwl starttype #o endtype #o
  length 150
  ChangeIfUnstressed(O#)
  FMT(mongolian/O)
endphoneme

// Reduced O (same quality, just shorter)
phoneme O#
  // Reduction lowers F1 only -- F2, F3 and every amplitude are byte-identical
  // to the full vowel, and the pairs move together. See mn.md section 10h.
  ipa O
  vwl starttype #o endtype #o
  length 100
  FMT(mongolian/O_red)
endphoneme

// 8 /o/ - mid rounded, ATR partner of о. Measured F1 327, F2 1082.
// ATR shows as lower F1, NOT as a higher F2: ө sits at essentially
// the same F2 as о (1082 vs 1089).
phoneme 8
  ipa 8
  vwl starttype #o endtype #o
  length 150
  ChangeIfUnstressed(8#)
  FMT(mongolian/oe)
endphoneme

// Reduced 8 (same quality, just shorter)
phoneme 8#
  // Reduction lowers F1 only -- F2, F3 and every amplitude are byte-identical
  // to the full vowel, and the pairs move together. See mn.md section 10h.
  ipa 8
  vwl starttype #o endtype #o
  length 100
  FMT(mongolian/oe_red)
endphoneme

// U /ʊ/ - near-close rounded, RTR. Measured F1 302, F2 990.
phoneme U
  ipa U
  vwl starttype #u endtype #u
  length 150
  ChangeIfUnstressed(U#)
  FMT(mongolian/u)
endphoneme

// Reduced U -- centralized. This one is measured on only 13 tokens, so the
// magnitude is weak, but pointing it at the full vowel is now definitely wrong:
// full у was lowered to F2 843 to restore the у/ү contrast, and reduced у moves
// the other way (the speaker centralizes it to 1034).
phoneme U#
  ipa U
  vwl starttype #u endtype #u
  length 100
  FMT(mongolian/u)
endphoneme

// y /u/ - close rounded, ATR partner of у. Measured F1 283, F2 800.
// Again ATR lowers F1; ү is BELOW у in F2, not above it.
phoneme y
  ipa u
  vwl starttype #u endtype #u
  length 140
  ChangeIfUnstressed(y#)
  FMT(mongolian/y)
endphoneme

// Reduced y (same quality, just shorter)
phoneme y#
  ipa u
  vwl starttype #u endtype #u
  length 95
  FMT(mongolian/y)
endphoneme

// @ /ə/ - central reduced vowel.
//
// CURRENTLY UNREACHABLE from mn_rules, and that is deliberate. It used to be
// the target for reduced non-initial vowels, but reduction is now
// harmony-preserving (а -> a#, ө -> 8# and so on, see mn_rules G3/G4), so a
// written vowel keeps its own quality instead of collapsing to a schwa. Nothing
// in Khalkha inserts a vowel that has no letter, so nothing emits this.
//
// It is kept defined rather than deleted for two reasons: base1 would otherwise
// supply its own @, which is an ENGLISH schwa, and the phoneme is referenced by
// the mn entry in tests/language-phonemes.test. Its formants are the centroid of
// the seven measured Mongolian vowels (F1 347, F2 1327), so if anything ever does
// reach it, it lands inside the Mongolian vowel space rather than an English one.
phoneme @
  ipa ə
  vwl starttype #@ endtype #@
  length 75
  FMT(mongolian/schwa)
endphoneme


