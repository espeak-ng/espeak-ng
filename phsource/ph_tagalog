// Phonemes for Tagalog (tl)
// Five vowels, no reduction of unstressed vowels.
// Consonants are inherited from base2 (p b t d k g ? m n N n^ s h l * w j tS dZ S f v z).


phoneme a
  vwl starttype #a endtype #a
  length 180
  FMT(vowel/a)
endphoneme


phoneme E
  vwl starttype #e endtype #e
  length 180
  FMT(vowel/e_mid)
endphoneme


phoneme i
  vwl starttype #i endtype #i
  length 170
  FMT(vowel/i)
endphoneme


phoneme o
  vwl starttype #o endtype #o
  length 180
  FMT(vowel/o)
endphoneme


phoneme u
  vwl starttype #u endtype #u
  length 170
  FMT(vowel/u)
endphoneme


// Diphthongs: aw, ay, iw, oy, uy

phoneme aI
  vwl starttype #a endtype #i
  length 230
  FMT(vdiph/ai)
endphoneme


phoneme aU
  vwl starttype #a endtype #u
  length 230
  FMT(vdiph/au_4)
endphoneme


phoneme oI
  vwl starttype #o endtype #i
  length 230
  FMT(vdiph/ooi)
endphoneme


phoneme uI
  vwl starttype #u endtype #i
  length 230
  FMT(vdiph/ui)
endphoneme


phoneme iU
  vwl starttype #i endtype #u
  length 230
  FMT(vdiph2/iu)
endphoneme
