// Asyllabic vowels

phoneme j/           // asyllabic vowel similar to [j] used with MBrola voices
  vwl starttype #i endtype #i
  ipa j
  length 150
  unstressed nsy
  FMT(vowel/i)
endphoneme

phoneme w/           // asyllabic vowel similar to [w] used with Mbrola voices
  vwl starttype #u endtype #u
  ipa w
  length 150
  unstressed nsy
  FMT(vowel/u_bck)
endphoneme


// Lateral Consonants

phoneme l
  liquid
  lengthmod 7

  IF NOT nextPhW(isVowel) AND NOT nextPhW(j) AND NOT nextPhW(w) THEN
      ChangePhoneme(l/2)
  ENDIF

  CALL vowelstart_l

  IF prevPh(#@) THEN
    VowelEnding(l/xl, -50)
  ELIF prevPh(isVowel) THEN
    VowelEnding(l/xl, -40)
  ENDIF

  IF prevPh(isPause) THEN
    FMT(l/_l)
  ENDIF

  FMT(l/l)
endphoneme

phoneme l/2
  liquid
  lengthmod 7

  IF NOT nextPhW(isVowel) AND NOT nextPhW(j) AND NOT nextPhW(w) THEN
    ipa ɫ
  ENDIF

  CALL vowelstart_l

  IF prevPhW(j) THEN
    FMT(l/L2_eL)
  ENDIF
  IF prevPhW(w) THEN
    FMT(l/L2_uL)
  ENDIF

  PrevVowelEndings
    VowelEnding(l/L2_@L, -60)
    VowelEnding(l/L2_aL, -50)
    VowelEnding(l/L2_eL, -40)
    VowelEnding(l/L2_iL, -30)
    VowelEnding(l/L2_oL, -50)
    VowelEnding(l/L2_uL, -40)
  EndSwitch
endphoneme

phoneme l^
  liquid pal
  lengthmod 7
  ipa ʎ

  CALL base1/l
  CALL base1/j
  IF nextPhW(#i) THEN
    CALL base1/;
  ENDIF
endphoneme


// Rhotic Consonants

phoneme x            // old strong /R/ kept for backward compatibility
  vls glt apr rhotic
  lengthmod 3
  CALL base1/h       // this glottal rhotic sounds better in eSpeak
  ipa x              // this grapheme is traditionally used by Brazilian linguists
endphoneme

phoneme *            // weak /r/ in syllable onset or coda
//vcd alv flp rhotic
  liquid rhotic
  lengthmod 3
  ipa ɾ

  Vowelin  f1=0 f2=1600 -300 300  f3=-200 80
  Vowelout f1=2 f2=1600 -300 300  f3=-200 80 brk

  IF prevPhW(isNotVowel) OR thisPh(isWordStart) THEN
    InsertPhoneme(@-) // ineffective after change
  ELIF nextPh(isNotVowel) AND NOT nextPh(j) AND NOT nextPh(w) AND NOT nextPh(isPause) THEN
    AppendPhoneme(@-)
  ENDIF

  IF nextPh(isPause) THEN
    FMT(d/tap2) addWav(x/d, 25)
  ELSE
    FMT(d/tap2)
  ENDIF
endphoneme

phoneme @-           // very short schwa used along with weak /r/ only
  vwl starttype #@ endtype #@
  unstressed nsy
  ipa NULL
  length 18
  FMT(vwl_pt/@-) // glotal cycle is 8.6 ms (F0 = 116Hz)
endphoneme


// Nasal Consonants

phoneme N/

// NOTE: This is a copy of "base1/N" with some modifications.
// Some instructions have been removed to avoid the clicking
// sounds caused by the `brk` tag and overlapping formants in
// the "nn/inn" file (F2 and F3 are too close to each other).

  vcd vel nas
  Vowelout f1=3 f2=2300 300 400  f3=-200 80  len=40 rms=20
  lengthmod 8
  ipa ŋ

  IF KlattSynth THEN
    Vowelin f1=0 f2=2100 50 300 f3=0 80
    IF nextPh(isPause2) THEN
      FMT(klatt/nn_)
    ENDIF
    FMT(klatt/nn)
  ENDIF

  NextVowelStarts
    VowelStart(nn/nn@)
    VowelStart(nn/nna)
    VowelStart(nn/nne)
    VowelStart(nn/nni)
    VowelStart(nn/nno)
    VowelStart(nn/nnu)
  EndSwitch

  IF prevPh(isNotVowel) AND nextPhW(isLiquid) THEN
    FMT(nn/nnj)
  ELIF prevPh(isPause) THEN
    FMT(nn/_nn)
  ELIF nextPh(isNotVowel) THEN
    FMT(nn/nn_)
  ENDIF
endphoneme

procedure Nn
  CALL base1/n
  ipa n
endprocedure

procedure Nm
  CALL base1/m
  ipa m
endprocedure

procedure Nw
  CALL base1/w
  ipa w
endprocedure

phoneme N            // polimorphic nasal consonant used in syllable coda
  vcd nas
  length 60          // the nasal murmur is short (when it exists)

  IF NOT thisPh(isWordEnd) AND nextPh(isVowel) THEN
    ChangePhoneme(n)
  ENDIF

  IF thisPh(isWordEnd) AND nextPh(isVowel) THEN
    IF prevPh(o~) OR prevPh(u~) THEN
      CALL Nw
    ELIF prevPh(#e) OR prevPh(#i) THEN
      CALL pt/N/
    ELSE
      CALL Nn
    ENDIF
    RETURN
  ENDIF

  IF nextPh(isPause) THEN
    IF prevPh(#i) THEN
      CALL pt/N/
    ELSE
      CALL Nm
    ENDIF
    RETURN
  ELIF nextPh(k) OR nextPh(g) THEN
    CALL pt/N/
  ELIF nextPh(p) OR nextPh(b) THEN
    CALL Nm
  ELIF prevPhW(#e) THEN
    CALL pt/N/
  ELSE
    CALL Nn
  ENDIF
endphoneme


// Vowel Aliases for Dialectal Variation

phoneme a#           // alias for /a/ in unstressed syllable
  vwl starttype #a endtype #a
  ChangePhoneme(a)
endphoneme

phoneme e#           // alias for /e/ in unstressed syllable
  vwl starttype #e endtype #e
  ChangePhoneme(e)
endphoneme

phoneme o#           // alias for /o/ in unstressed syllable
  vwl starttype #o endtype #o
  ChangePhoneme(o)
endphoneme


// Consonant Aliases for Dialectal Variation

phoneme l#           // alias for /w/ in coda
  liquid
  IF nextPhW(isVowel) THEN
    ChangePhoneme(l) // necessary for words with suffixes
  ENDIF
  ChangePhoneme(w)
endphoneme

phoneme s#           // alias for /s/ or /z/ in coda
  vls alv frc sib
  IF nextPh(isVoiced) THEN
    ChangePhoneme(z)
  ENDIF
  ChangePhoneme(s)
endphoneme

phoneme R#           // alias for strong /R/ in onset
  vls glt apr rhotic
  ChangePhoneme(x)
endphoneme

phoneme r#           // alias for weak /r/ in coda
//vcd alv flp rhotic
  liquid rhotic
  IF thisPh(isWordStart) THEN
    ChangePhoneme(x)
  ENDIF
  ChangePhoneme(*)
endphoneme

phoneme d#           // alias for /d/ or /dZ/
  vcd alv stp
  IF nextPhW(#i) THEN
    ChangePhoneme(dZ)
  ELIF thisPh(isWordEnd) THEN
    ChangePhoneme(dZ)
  ENDIF
  ChangePhoneme(d)
endphoneme

phoneme t#           // alias for /t/ or /tS/
  vls alv stp
  IF nextPhW(#i) THEN
    ChangePhoneme(tS)
  ELIF thisPh(isWordEnd) THEN
    ChangePhoneme(tS)
  ENDIF
  ChangePhoneme(t)
endphoneme


// Other Aliases for Dialectal Variation

phoneme 3#           // alias for /e/ in English words ended with /er/
  vwl starttype #e endtype #e
  ChangePhoneme(e)
endphoneme

