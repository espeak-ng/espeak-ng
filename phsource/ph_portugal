
//====================================================
//  Portuguese/Portugal  - based on Portuguese/Brazil
//====================================================

// This phonemes file is refered as "pt-pt" in language and voice files.
// The phonemes specified in the file `ph_pt_brazil` are also used here.


// Vowels

phoneme &
  vwl starttype #@ endtype #@
  length 180
  ipa ɐ
  FMT(vowel/a#_3)
  unstressed
endphoneme

phoneme a
  vwl starttype #a endtype #a
  length 180
  ChangeIfNotStressed(&)
  FMT(vowel/a_2)
endphoneme

phoneme e
  vwl starttype #e endtype #e
  length 180
  ChangeIfUnstressed(y)
  FMT(vowel/e)
endphoneme

phoneme E
  vwl starttype #e endtype #e
  length 180
  FMT(vowel/e_mid)
endphoneme

phoneme i/            // changes to NULL before a vowel
  vwl starttype #i endtype #i
  length 130
  ipa ɨ
  IF nextPh(isVowel) THEN
    ChangePhoneme(NULL)
  ENDIF
  IfNextVowelAppend(;)
  FMT(vowel/i#_5)
endphoneme

phoneme I/           // hiding the very short [i] used for epenthesis
  vwl starttype #i endtype #i
  ChangePhoneme(NULL)
endphoneme

phoneme y            // old unstressed /i/ kept for backward compatibility
  vwl starttype #@ endtype #@
  CALL pt/i"
endphoneme

phoneme o
  vwl starttype #o endtype #o
  length 180
  ChangeIfNotStressed(u)
  FMT(vowel/o)
endphoneme

phoneme O
  vwl starttype #o endtype #o
  length 180
  FMT(vowel/0_2)
endphoneme

phoneme u
  vwl starttype #u endtype #u
  length 180
  FMT(vowel/u_6)
endphoneme

phoneme U
  vwl starttype #u endtype #u
  length 130
  IF thisPh(isWordEnd) AND thisPh(isUnstressed) THEN
    IF NOT prevPh(w) AND nextPh(isVowel) THEN
      ChangePhoneme(w)
    ENDIF
  ENDIF
  FMT(vowel/u_6)
endphoneme


// Nasal Vowels

phoneme &~
  vwl  starttype #e endtype #@
  ipa ɐU+0303
  length 240
  FMT(vnasal/ee_n2)
endphoneme


// Diphthongs

phoneme EU
  vwl starttype #e endtype #u
  length 230
  FMT(vdiph/eeu_2)
endphoneme


// Nasal Diphthongs

phoneme &U~
  vwl  starttype #@ endtype #u
  ipa ɐU+0303ʊU+0303
  length 240
  IF thisPh(isDiminished) THEN
    FMT(vnasal/au_n)
  ENDIF
  FMT(vnasal/a#u_n)
endphoneme


// Glides

phoneme w
  import_phoneme base2/w2
endphoneme


// Lateral Consonants

phoneme l/2          // substitutes "en/l" in the case of 'dark' /l/
  liquid
  lengthmod 7
  CALL base1/l/2
  IF NOT nextPhW(isVowel) AND NOT nextPhW(j) AND NOT nextPhW(w) THEN
    ipa ɫ            // when the next phoneme in word is a consonant
  ENDIF
endphoneme


// Rhotic Consonants

phoneme x            // old strong /R/ kept for backward compatibility
//vcd uvl frc rhotic
  liquid trl
  ipa ʁ
  lengthmod 7
  Vowelin f1=0  f2=1500 -400 400  f3=-400 80
  IF nextPh(isNotVowel) THEN
    ChangePhoneme(r/)
  ENDIF
  FMT(vwl_fr/@R) addWav(r3/rx, 120)
endphoneme


// Vowel Aliases for Dialectal Variation

phoneme a#           // alias for /&/ in unstressed syllable
  vwl starttype #@ endtype #@
  ChangePhoneme(&)
endphoneme

phoneme e#           // alias for /y/ in unstressed syllable
  vwl starttype #@ endtype #@
  ChangePhoneme(y)
endphoneme

phoneme o#           // alias for /u/ in unstressed syllable
  vwl starttype #u endtype #u
  ChangePhoneme(u)
endphoneme


// Consonant Aliases for Dialectal Variation

phoneme l#           // alias for /l/ in coda
  liquid
  ChangePhoneme(l/2)
endphoneme

phoneme s#           // alias for /S/, /Z/ or /z/ in coda
  vls pla frc sib
  IF nextPh(isVowel) THEN
    ChangePhoneme(z)
  ELIF nextPh(isVoiced) OR nextPh(d#) THEN
    ChangePhoneme(Z)
  ENDIF
  ChangePhoneme(S)
endphoneme

phoneme R#           // alias for strong /R/ in onset
//vcd uvl frc rhotic
  liquid trl
  ChangePhoneme(x)
endphoneme

phoneme r#           // alias for weak /r/ in coda
  vcd alv flp rhotic
  IF thisPh(isWordStart) THEN
    ChangePhoneme(x)
  ENDIF
  ChangePhoneme(*)
endphoneme

phoneme d#           // alias for /d/
  vcd alv stp
  ChangePhoneme(d)
endphoneme

phoneme t#           // alias for /t/
  vls alv stp
  ChangePhoneme(t)
endphoneme


// Other Aliases for Dialectal Variation

phoneme 3#           // alias for /@/ in English words ended with /er/
  vwl starttype #@ endtype #@
  ChangePhoneme(&)
endphoneme

