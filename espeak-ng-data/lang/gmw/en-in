name English (India)
language en-in 2
language en 3

maintainer Animesh Ahilya <animesh@example.com>
status mature

// Indian English: syllable-timed, rhotic, with full vowels.
// Phoneme table en-in (ph_english_in) adds retroflex stops t./d.,
// monophthongal eI/oU and clear l on top of the base en table.
phonemes en-in
// 12 = Indian English. It carries its own copy of the ?8 full-vowel rules
// (-ment, -ness, -less, -al...), minus the -ed one: the OED model has no
// full vowel in a separate-syllable -ed (wanted [ʋɔnʈɪɖ], not [-ɛɖ]).
dictrules 12

stressLength 160 160  180 180  200 200  240 260
stressAmp    18 18   19 19   19 19   20 20

// --- Consonants: Indian English substitutions ---
// v/w merger -> labiodental approximant [ʋ] (Wells 1982; Sailaja 2009; OED IndE).
// Old mapping used fricative [v]; v# is the approximant (phsource/phonemes).
replace 00 w v#
replace 00 v v#
// Dental fricatives -> dental stops: thin->[t̪ʰɪn], this->[d̪ɪs]
// (no interdental in L1s; OED IndE; IJSCL/Bytko 2017).
replace 00 T t[
replace 00 D d[
// Alveolar stops -> retroflex [ʈ ɖ]: time->[ʈaɪm], water->[ʋaːʈər]
// (Gargesh 2008; Sailaja 2009; OED IndE; Sirsa & Redford 2013).
// t./d. are defined in ph_english_in (mirrors ph_hindi).
// tS/dZ are single phonemes so affricates are unaffected.
// t2 is the non-reducing [t] variant emitted by en_rules (time, top,
// type...); t# is the American flap allophone that can surface via shared
// en_list entries - IndE uses retroflex stops there, not flaps. d# is the
// -ed suffix, which IndE says as [ɖ] whatever comes before: missed [mɪsɖ]
// (OED IndE, after Gargesh 2008 and Sailaja 2009).
// r- is the linking-r allophone; IndE is fully rhotic by spelling.
replace 00 t t.
replace 00 t2 t.
replace 00 t# t.
replace 00 d d.
replace 00 d# d.
replace 00 r- r.
// Rhotic with retroflex colouring; spelling r always pronounced
// (OED IndE: generally rhotic; Gargesh vs Sailaja variation).
replace 00 r r.
// [ʒ] -> [dʒ]: leisure->[liːdʒər], vision->[ʋɪdʒən] (OED IndE transcribes /dʒ/).
replace 00 Z dZ

// --- Vowels: monophthongization ---
// FACE /eɪ/ -> [eː]: day->[deː]; GOAT /oʊ/ -> [oː]: go->[ɡoː]
// (Sailaja 2009; IISc Rao et al.; OED IndE).
// aI/aU/OI stay diphthongal per literature.
replace 00 eI e:
replace 00 oU o:
// BATH/PALM is long [ɑː]: bath [bɑːt̪], dance [ɖɑːns] (OED IndE).
replace 00 aa A:

formant 1 100 100 100
formant 2 100 100 100
