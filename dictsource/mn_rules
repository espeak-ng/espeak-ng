        // it and the /j/ after it are both voiced -- so л takes the voiced
        // lateral, the same as the `L04) л (L04` rule below. This read l#
        // (voiceless) and gave алье [aɬje] against алаа [aɮaː], which is the
        // same group contradicting its own voicing rule.
        L04) л (ьL08    l
        л (ьL08         l#
        // Word-final ль surfaces as a GLIDE BEFORE the lateral, not as a
        // palatalised lateral after it: сургууль is [surɢuːi̯ɬ], "сургуйл",
        // not [surɢuːʎ] which a native speaker heard as "сургуули".
        // The lateral itself stays voiceless, exactly as in сургуул.
        л (ь_           jl#
        л (ь            l;
        _) л            l#
        л (_            l#
        л (L06          l#
        L06) л          l#
        // An intervocalic GEMINATE is just as voiced as a single intervocalic
        // л, but the rule below needs a vowel on both sides and a doubled
        // letter puts a consonant on one, so both halves fell through to the
        // voiceless l# -- байгууллага [pai̯quːɬɬaqa], долларын [tɔɬɬariŋ].
        // Khalkha л is /ɮ/, devoicing only next to a voiceless segment or at a
        // word edge; a geminate between two vowels has neither. Both halves
        // take the voiced lateral, matching алаа below.
        L04) л (лL04    l       // first half:  V _ л V
        L04л) л (L04    l       // second half: V л _ V
        L04) л (L04     l
        л               l#

