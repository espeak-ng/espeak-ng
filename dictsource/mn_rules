// -- Neutral vowels: exempt from deletion (case-suffix vowels) --

.group и
        ий (+++             i:
        ии (+++             i:
        и                   i

.group ы
        ый (+++             i:
        ы                   i


// -- Iotated vowels: я, ё, ю, е ---------------------------------
//
// Mongolian я ё ю always carry their glide, unlike Russian, where
// after a consonant they merely palatalise it. Writing them as j+V
// is also what realises palatalisation on labials and velars, since
// [mʲa] and [mja] are the same percept.
//
// е is the exception: /je/ word-initially and after a vowel or ь,
// but plain /e/ after a consonant (mostly Russian loanwords).

.group я
        яа (+++             ja:
        я                   ja

.group ё
        ёо (+++             jO:
        ё                   jO

.group ю
        юү (+++             jy:
        юу (+++             jU:
        ю                   jU

.group е
        // ъ is the hard sign, and marking this glide is the whole reason it is
        // written. There was a rule for ь but none for ъ, so е fell through to
        // the plain catch-all and объект came out [ɔpekt] with no /j/ at all.
        // ё, ю and я keep theirs only because they emit /j/ unconditionally.
        ъ) е                je
        ь) е                je
        _) еэ               je:
        A) еэ               je:
        еэ                  e:
        _) ее               je:
        _) е                je
        A) е                je
        е                   e


// ============================================================
//  CONSONANTS
//
//  Each consonant that can be palatalised carries two ь rules:
//
//      C (ьL08    <plain>      // ья/ье/ьё/ью/ьи -- the vowel
//                              // supplies the glide, so the
//                              // consonant must NOT add a second
//                              // one (ярья is [jarja])
//      C (ь       <palatal>    // ь at a syllable coda (морь)
// ============================================================

// -- Unaspirated stops: б д г -----------------------------------

.group б
        б (ьL08     p
        б (ь        pj
        б           p

.group д
        д (ьL08     t
        д (ь        t;
        д           t

// г has two surface forms, chosen by the harmony class of the
// WORD rather than by the neighbouring letter alone:
//   k   velar stop  - front-harmony words
//   q   uvular stop - back-harmony words
//
// There used to be a third, Q" (uvular fricative [ʁ]), for the
// intervocalic position: бага was [paʁa]. A native speaker could not
// understand that word, nor байгууллага or сургууль -- the three
// "didn't understand" items that contained a uvular. Offered a choice
// between the fricative, a uvular stop, and no uvular at all, he chose
// the STOP. So the harmony-driven uvular allophone is right and only its
// fricative realisation was wrong: г is a stop in every position.
// The -гт- cluster lenites to a fricative in both classes
// (цагт [tsʰaχt], эгшиг [ekʃik]).
.group г
        // ь + an iotated vowel: palatalised, but the vowel brings its
        // own /j/ so this must NOT add one. Needs the full harmony ladder
        // because the `(ь` rules below outrank a bare `(ьL08` guard and
        // would otherwise double the glide (өгье -> [ɵkjje]).
        L01L10L10L10) г (ьL08	q
        L01L10L10) г (ьL08	q
        L01L10) г (ьL08	q
        L01) г (ьL08	q
        L02L10L10L10) г (ьL08	k
        L02L10L10) г (ьL08	k
        L02L10) г (ьL08	k
        L02) г (ьL08	k

        // Same as х above: .L05 contains ь, so the `L01) г (L05` ladder was
        // eating г before ь and the palatalisation never fired (баг and багь
        // were identical). Harmony still applies through the ь.
        L01L10L10L10) г (ь     qj
        L01L10L10) г (ь     qj
        L01L10) г (ь        qj
        L01) г (ь           qj
        L02L10L10L10) г (ь     kj
        L02L10L10) г (ь     kj
        L02L10) г (ь        kj
        L02) г (ь           kj
        г (ь                kj

        L02L10L10L10) г (т     x
        L02L10L10) г (т     x
        L02L10) г (т        x
        L02) г (т           x
        L01L10L10L10) г (т     X
        L01L10L10) г (т     X
        L01L10) г (т        X
        L01) г (т           X
        г (т                X

        L01) г (L04+        q       // intervocalic, back-harmony word

        L01L10L10L10) г (и     q       // и is transparent to harmony
        L01L10L10) г (и     q       // и is transparent to harmony
        L01L10) г (и        q
        L01) г (и           q       // zero-gap rung: the ladder was missing
        L01L10L10L10) г (й     q
        L01L10L10) г (й     q
        L01L10) г (й        q
        L01) г (й           q
        L02L10L10L10) г (и     k
        L02L10L10) г (и     k
        L02L10) г (и        k
        L02) г (и           k

        г (L01              q
        г (L02              k
        г (и                k

        L01L10L10L10) г (_     q
        L01L10L10) г (_     q
        L01L10) г (_        q
        L01) г (_           q
        L02L10L10L10) г (_     k
        L02L10L10) г (_     k
        L02L10) г (_        k
        L02) г (_           k
        L01L10L10L10) г (L05   q
        L01L10L10) г (L05   q
        L01L10) г (L05      q
        L01) г (L05         q
        L02L10L10L10) г (L05   k
        L02L10L10) г (L05   k
        L02L10) г (L05      k
        L02) г (L05         k

        г                   k


