// -- Fricatives -------------------------------------------------

// х is uvular [χ] in back-harmony words, velar [x] in front ones.
// This is the clearest single audible cue to a word's harmony class.
.group х
        // ь + an iotated vowel: palatalised, but the vowel brings its
        // own /j/ so this must NOT add one. Needs the full harmony ladder
        // because the `(ь` rules below outrank a bare `(ьL08` guard and
        // would otherwise double the glide (өгье -> [ɵkjje]).
        L01L10L10L10) х (ьL08	X
        L01L10L10) х (ьL08	X
        L01L10) х (ьL08	X
        L01) х (ьL08	X
        L02L10L10L10) х (ьL08	x
        L02L10L10) х (ьL08	x
        L02L10) х (ьL08	x
        L02) х (ьL08	x

        // ь palatalises х, and harmony still decides velar vs uvular.
        // These need the harmony context spelled out because .L05 includes
        // ь, so the plain `L01) х (L05 -> X` ladder below was matching х
        // before ь and winning on context length. The effect was that дах
        // and дахь synthesised to byte-identical audio (both t'aX), and the
        // same for нөх/нөхь, баг/багь, ах/ахь -- different words, same sound.
        L01L10L10L10) х (ь     Xj
        L01L10L10) х (ь     Xj
        L01L10) х (ь        Xj
        L01) х (ь           Xj
        L02L10L10L10) х (ь     xj
        L02L10L10) х (ь     xj
        L02L10) х (ь        xj
        L02) х (ь           xj
        х (ь                xj

        х (L01              X
        х (L02              x

        // и is harmonically TRANSPARENT (.L03), so х before и must take the
        // harmony class of the vowel further back, not default to velar.
        // The г group below already does this and says so in a comment; х
        // was left with a bare `х (и -> x`, which gave back-harmony words the
        // front allophone: борхи, тохир, унших and ногоохи all came out with
        // velar [x] where Khalkha has uvular [χ].
        L01L10L10L10) х (и     X
        L01L10L10) х (и     X
        L01L10) х (и        X
        L01) х (и           X
        L02L10L10L10) х (и     x
        L02L10L10) х (и     x
        L02L10) х (и        x
        L02) х (и           x
        х (и                x

