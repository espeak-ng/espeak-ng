        L01L10) х (_        X
        L01) х (_           X
        L02L10L10L10) х (_     x
        L02L10L10) х (_     x
        L02L10) х (_        x
        L02) х (_           x
        L01L10L10L10) х (L05   X
        L01L10L10) х (L05   X
        L01L10) х (L05      X
        L01) х (L05         X
        L02L10L10L10) х (L05   x
        L02L10L10) х (L05   x
        L02L10) х (L05      x
        L02) х (L05         x

        х                   x

.group с
        с (ьL08     s
        с (ь        s;
        с           s

